# ============================================================
# FMCG SupplyChainIQ — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env.
# All secrets, connection strings, and tunable paths live here.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_LOG_LEVEL=INFO

# ---- MongoDB ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB_NAME=fmcg_supplychainiq
# Full URI (overrides individual fields above when set)
MONGO_URI=

# ---- Hadoop HDFS ----
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9000
HDFS_WEBUI_PORT=9870
HDFS_ROOT_PATH=/fmcg-supplychainiq
HDFS_USER=fmcg

# ---- Spark ----
SPARK_MASTER=yarn
SPARK_DEPLOY_MODE=client
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_NUM_EXECUTORS=2
SPARK_YARN_QUEUE=default

# ---- File system paths (remote) ----
DATA_DIR=/data/fmcg
MONGODB_DATA_DIR=/data/mongodb
HADOOP_NAMENODE_DIR=/data/hadoop/namenode
HADOOP_DATANODE_DIR=/data/hadoop/datanode
SPARK_TMP_DIR=/data/spark/tmp
MODEL_DIR=/data/fmcg/models
LOG_DIR=/data/fmcg/logs

# ---- Data generation ----
GENERATOR_SEED=42
GENERATOR_SIZE=small  # small | medium | large | xlarge
GENERATOR_OUTPUT_DIR=data/generated

# ---- FastAPI ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# ---- Streamlit ----
DASHBOARD_PORT=8501

# ---- Pipeline ----
PIPELINE_CHECKPOINT_DIR=/data/fmcg/checkpoints
PIPELINE_FAIL_FAST=false
