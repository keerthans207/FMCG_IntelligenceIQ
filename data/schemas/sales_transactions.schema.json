{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SalesTransaction",
  "description": "Point-of-sale sales transaction record",
  "type": "object",
  "required": ["transaction_id", "transaction_timestamp", "sku_id", "store_id", "units_sold", "unit_price", "promotion_flag"],
  "properties": {
    "transaction_id": { "type": "string", "pattern": "^TXN[0-9]{10}$" },
    "transaction_timestamp": { "type": "string", "format": "date-time" },
    "sku_id": { "type": "string", "pattern": "^SKU[0-9]{5}$" },
    "store_id": { "type": "string", "pattern": "^LOC[0-9]{4}$" },
    "units_sold": { "type": "integer", "minimum": 1 },
    "unit_price": { "type": "number", "minimum": 0 },
    "promotion_flag": { "type": "boolean" }
  },
  "additionalProperties": false
}
