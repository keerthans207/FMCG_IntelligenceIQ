{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InventorySnapshot",
  "description": "Point-in-time inventory snapshot for a location/SKU/batch combination",
  "type": "object",
  "required": ["snapshot_id", "snapshot_timestamp", "location_id", "sku_id", "batch_id", "on_hand_quantity", "reserved_quantity"],
  "properties": {
    "snapshot_id": { "type": "string", "pattern": "^SNP[0-9]{10}$" },
    "snapshot_timestamp": { "type": "string", "format": "date-time" },
    "location_id": { "type": "string", "pattern": "^LOC[0-9]{4}$" },
    "sku_id": { "type": "string", "pattern": "^SKU[0-9]{5}$" },
    "batch_id": { "type": "string", "pattern": "^BAT[0-9]{6}$" },
    "on_hand_quantity": { "type": "integer", "minimum": 0 },
    "reserved_quantity": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
