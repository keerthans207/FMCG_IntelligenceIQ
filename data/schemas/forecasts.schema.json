{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forecast",
  "description": "Demand forecast for an SKU/location/date combination",
  "type": "object",
  "required": ["forecast_id", "sku_id", "location_id", "forecast_date", "predicted_units", "model_version", "created_at"],
  "properties": {
    "forecast_id": { "type": "string" },
    "sku_id": { "type": "string" },
    "location_id": { "type": "string" },
    "forecast_date": { "type": "string", "format": "date" },
    "predicted_units": { "type": "number", "minimum": 0 },
    "model_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
